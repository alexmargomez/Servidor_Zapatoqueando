{
  "name": "api_zapatoqueando",
  "version": "1.0.0",
  "description": "Backend API para la plataforma Zapatoqueando",
  "main": "dist/server.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "tsc && node dist/shared/infrastructure/database/migrate.js && node dist/server.js",
    "dev": "ts-node src/shared/infrastructure/database/migrate.ts && ts-node src/server.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "osmtogeojson": "^3.0.0-beta.5",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.10",
    "jest": "^29.7.0",
    "nodemon": "^3.0.3",
    "prisma": "^5.22.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
